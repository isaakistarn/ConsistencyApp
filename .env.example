# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). The anon key is safe for the client — RLS
# constrains it. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base path for the built site. Defaults to /consistency/ (GitHub Pages
# project site). Set to / when deploying to a custom domain.
# VITE_BASE_PATH=/consistency/
